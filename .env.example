# Environment variables required to run the project.
# Copy this file to `.env` and fill in the values. `.env` is ignored by Git — never commit it.
#
#   cp .env.example .env && chmod 600 .env

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. SECRET: if it leaks, revoke it with /revoke.
TELEGRAM_BOT_TOKEN=

# Group "Flights": chat ID (supergroups start with -100).
TELEGRAM_FLIGHTS_CHAT_ID=

# Topic "Bilbao" inside the "Flights" group (message_thread_id).
TELEGRAM_FLIGHTS_BIO_TOPIC_ID=
