terraform {
  required_version = ">= 1.12" # native "oci" state backend

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = "~> 9.11" # exact version pinned in .terraform.lock.hcl
    }
  }

  # State lives in the bucket created by the bootstrap stack. bucket, namespace, key and
  # region come from backend.hcl (generated by `make tf-backend-config`, ignored by Git).
  backend "oci" {
    config_file_profile = "DEFAULT"
  }
}

# Credentials and region come from ~/.oci/config, never from this repo.
provider "oci" {
  config_file_profile = var.oci_profile
}
