# Files Git must never track: secrets, local state, caches and editor files.

# Secrets — never commit these
.env
*.env
!*.env.example
secrets/
*.pem
*.key

# Local data (SQLite price history)
data/
*.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
backend.hcl
.terraform.lock.hcl.bak

# Kubernetes
kubeconfig
*.kubeconfig

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
